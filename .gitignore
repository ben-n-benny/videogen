# ---------------------------------------------------------------------------
# Python & Virtual Environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ---------------------------------------------------------------------------
# VideoGen Render Caches & Temporary Frame Buffers
# ---------------------------------------------------------------------------
**/.videogen_cache/
**/_tmp_*_frames/
*.neural_tmp.mp3
*.ass.tmp

# ---------------------------------------------------------------------------
# Rendered Video Outputs & Large Media Assets
# (Keeps `project.json` and `youtube_metadata.txt` tracked in Git)
# ---------------------------------------------------------------------------
projects/**/output/*.mp4
projects/**/output/*.mov
projects/**/output/*.mkv
projects/**/output/*.m4a
projects/**/output/*.wav

# Generated scene videos, voiceovers & BGM WAVs (regenerated by build_*.py / videogen.py)
projects/**/assets/videos/*.mp4
projects/**/assets/voiceovers/*.wav
projects/**/assets/audio/*.wav

# ---------------------------------------------------------------------------
# Environment, Secrets & OS / Editor Files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
